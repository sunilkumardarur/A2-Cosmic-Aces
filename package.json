{
  "name": "a2-cosmic-aces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "art": "node tools/render-art.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "data": "python tests/data_validation.py",
    "check": "npm run lint && npm run typecheck && npm run test && npm run data"
  },
  "dependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@fontsource/exo-2": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "electron": "^45.3.1",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
